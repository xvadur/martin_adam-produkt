  "services": {
    "eyebrow": "Moje služby",
    "title": "Služby online asistenta",
    "intro": [
      "Ako online asistent poskytujem širokú škálu služieb. Od administratívnych cez virtuálne asistovanie až po zákaznícku podporu."
    ],
    "items": [
      {
        "number": "01.",
        "title": "Vytvorenie databázy z verejne prístupných zdrojov",
        "paragraphs": [
          "Zabezpečím vytvorenie databázy z verejne prístupných zdrojov. Databázu následne môžeme použiť ako zdroj kontaktov na oslovenie nových zákazníkov. O vytvorenie databázy môžete požiadať aj v prípade, že nebudete chcieť realizovať následné oslovenie kontaktov."
        ],
        "cta": {
          "label": "Zobraziť viac",
          "url": "https://www.onlineasistent.sk/vytvorenie-databazy/",
          "sourceWidgetId": "3dc1b44"
        },
        "image": {
